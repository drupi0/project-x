{
  "name": "refugee-interview-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": { "#lib": "./src/lib", "#lib/*": "./src/lib/*" },
  "engines": { "node": ">=22.17.0" },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "dev:debug": "AI_DEBUG=1 vite dev --host 127.0.0.1",
    "logs:ollama": "tail -n 50 -f \"$HOME/.ollama/logs/server.log\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "latest",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "latest",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
