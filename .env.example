AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
AI_TIMEOUT_MS=120000
# Metadata-only diagnostics in the development-server terminal; never logs message text.
AI_DEBUG=0
# Temporary masked Claude output-shape diagnostics. Only works with NODE_ENV=development.
# Fictional test data only; never enable for real testimony. Docker production ignores it.
AI_DEBUG_RAW_FICTIONAL=0
# Optional Anthropic API key. Non-empty value selects Claude instead of Ollama.
# Conversations will be sent to Anthropic when enabled.
CLAUDE_TOKEN=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Docker Compose connects to Ollama installed and running on the host.
APP_PORT=3000
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Replaceable speech-to-text service; never sent to the browser.
STT_PROVIDER=whisper
WHISPER_BASE_URL=http://127.0.0.1:8081
STT_TIMEOUT_MS=120000
WHISPER_MODEL=tiny
DOCKER_WHISPER_BASE_URL=http://whisper:8080
